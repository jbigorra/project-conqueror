{
  "name": "@prj-conq/code-maat-ts",
  "description": "A typescript port of code-maat https://github.com/adamtornhill/code-maat",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "CI=true bunup",
    "test": "bun test tests/code_maat/*",
    "tdd": "bun test tests/code_maat/* --watch",
    "test:coverage": "bun test tests/code_maat/* --coverage",
    "test:parity": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run typecheck && bun test && biome check --write .",
    "lint": "biome check .",
    "check": "biome check --write .",
    "check:changed": "biome check --write --changed",
    "check:staged": "biome check --write --staged"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "csv-parse": "6.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@prj-conq/config": "workspace:*",
    "@types/bun": "^1.3.11",
    "bun-automock": "^0.2.5",
    "bunup": "^0.16.31",
    "fishery": "2.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.11"
  }
}
