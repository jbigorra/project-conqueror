{
  "name": "@prj-conq/lizard-ts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#lizard/*": "./src/*"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "CI=true bunup",
    "dev": "bunup --watch",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "tdd": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "check:changed": "biome check --write --changed",
    "check:staged": "biome check --write --staged",
    "validate": "bun run typecheck && bun test && biome check --write ."
  },
  "dependencies": {
    "@prj-conq/lib": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@prj-conq/typescript-config": "workspace:*",
    "@types/bun": "^1.3.11",
    "bun-automock": "0.2.5",
    "bunup": "^0.16.31",
    "typescript": "^5.9.3"
  }
}
