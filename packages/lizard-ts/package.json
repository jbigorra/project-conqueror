{
	"name": "@prj-conq/lizard-ts",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#lizard/*": "./src/*"
	},
	"engines": {
		"bun": ">=1.2.21"
	},
	"packageManager": "pnpm@10.14.0",
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"tdd": "bun test --watch",
		"check": "biome check . --write"
	},
	"dependencies": {
		"@prj-conq/lib": "workspace:^"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@prj-conq/typescript-config": "workspace:*",
		"@types/bun": "latest",
		"bun-automock": "0.2.5",
		"bunup": "^0.16.31",
		"typescript": "^5.9.3"
	}
}
