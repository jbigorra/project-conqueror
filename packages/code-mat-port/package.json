{
  "name": "code-mat-port",
  "description": "A typescript port of code-maat https://github.com/adamtornhill/code-maat",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test tests/code_maat/*",
    "test:tdd": "bun test tests/code_maat/* --watch",
    "test:coverage": "bun test tests/code_maat/* --coverage",
    "test:parity-check": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src/ tests/",
    "lint": "biome lint --write src/ tests/",
    "check": "biome check --write src/ tests/",
    "validation": "bun run typecheck && bun run lint && bun run format && bun run check && bun run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "csv-parse": "6.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@prj-conq/typescript-config": "workspace:*",
    "@types/bun": "^1.3.11",
    "bun-automock": "^0.2.5",
    "bunup": "^0.16.31",
    "fishery": "2.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.11"
  }
}
