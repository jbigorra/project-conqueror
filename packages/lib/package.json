{
  "name": "@prj-conq/lib",
  "description": "Library containting different utility classes and patterns.",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    "./generics": {
      "import": {
        "types": "./dist/generics/index.d.ts",
        "default": "./dist/generics/index.js"
      }
    },
    "./patterns": {
      "import": {
        "types": "./dist/patterns/index.d.ts",
        "default": "./dist/patterns/index.js"
      }
    },
    "./processes": {
      "import": {
        "types": "./dist/processes/index.d.ts",
        "default": "./dist/processes/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#lib/*": "./src/*"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "tdd": "bun test --watch"
  },
  "keywords": [
    "library",
    "common",
    "patterns",
    "typescript",
    "utilities"
  ],
  "author": "Juan Bigorra <jbigorra.soft.eng@pm.me>",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@prj-conq/typescript-config": "workspace:*",
    "@types/bun": "^1.3.11",
    "@types/node": "^24.10.1",
    "bun-automock": "^0.2.5",
    "bunup": "^0.16.31",
    "typescript": "^5.9.3"
  }
}
