{
  "name": "@prj-conq/webapp",
  "private": true,
  "version": "0.1.0",
  "description": "Modulithic web application for Project Conqueror",
  "exports": {
    ".": "./src/main.ts"
  },
  "imports": {
    "#package.json": "./package.json",
    "#shared/http/*": "./src/shared/infrastructure/http/*",
    "#shared/server/*": "./src/shared/infrastructure/server/*",
    "#shared/client/*": "./src/shared/infrastructure/client/*",
    "#shared/ui/components/*": "./src/shared/presentation/ui/components/*",
    "#shared/ui/partials/*": "./src/shared/presentation/ui/partials/*",
    "#shared/ui/layouts/*": "./src/shared/presentation/ui/layouts/*",
    "#upload/*": "./src/features/upload/*",
    "#analyses/*": "./src/features/analyses/*"
  },
  "scripts": {
    "build": "tsc",
    "build:prod": "NODE_ENV=production bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/main.ts",
    "dev": "NODE_ENV=development bun run --hot ./src/main.ts",
    "dev:debug": "NODE_ENV=development bun --inspect-wait run --watch ./src/main.ts",
    "clean": "rm -rf dist && rm tsconfig.tsbuildinfo || echo 'No tsconfig.tsbuildinfo file found'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tdd": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@prj-conq/behave": "workspace:*",
    "@prj-conq/lib": "workspace:*",
    "@prj-conq/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^3.2.4",
    "fishery": "^2.3.1",
    "playwright": "^1.54.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vitest-browser-react": "^1.0.1",
    "vitest-mock-extended": "^3.1.0"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.3.2",
    "@elysiajs/html": "^1.3.1",
    "@elysiajs/opentelemetry": "^1.3.1",
    "@elysiajs/static": "^1.3.0",
    "@elysiajs/swagger": "^1.3.1",
    "@kitajs/html": "^4.2.9",
    "@kitajs/ts-html-plugin": "^4.1.2",
    "bun-types": "^1.2.20",
    "elysia": "^1.3.8",
    "logixlysia": "^5.1.0"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "bun": ">=1.2.2"
  }
}
