{
  "name": "@prj-conq/webapp",
  "private": true,
  "version": "0.1.0",
  "description": "Modulithic web application for Project Conqueror",
  "type": "module",
  "module": "src/main.ts",
  "exports": {
    ".": "./src/main.ts"
  },
  "imports": {
    "#error.ts": "./src/errors.ts",
    "#package.json": "./package.json",
    "#shared/generics-types/*": "./src/shared/generics-types/*",
    "#shared/domain/*": "./src/shared/infrastructure/domain/events/*",
    "#shared/event/*": "./src/shared/infrastructure/event/*",
    "#shared/dependencies/*": "./src/shared/dependencies/*",
    "#shared/fs/*": "./src/shared/infrastructure/fs/*",
    "#shared/logging/*": "./src/shared/infrastructure/logging/*",
    "#shared/database/*": "./src/shared/infrastructure/database/*",
    "#shared/http/*": "./src/shared/infrastructure/http/*",
    "#shared/server/*": "./src/shared/infrastructure/server/*",
    "#shared/client/*": "./src/shared/infrastructure/client/*",
    "#shared/ui/components/*": "./src/shared/presentation/ui/components/*",
    "#shared/ui/partials/*": "./src/shared/presentation/ui/partials/*",
    "#shared/ui/layouts/*": "./src/shared/presentation/ui/layouts/*",
    "#upload/*": "./src/features/upload/*",
    "#analyses/*": "./src/features/analyses/*"
  },
  "scripts": {
    "build": "NODE_ENV=production bun build --compile --minify-whitespace --minify-syntax --target bun --outfile temp/server ./src/main.ts",
    "build:prod": "NODE_ENV=production bun build --compile --minify-whitespace --minify-syntax --target bun --outfile temp/server ./src/main.ts",
    "dev": "NODE_ENV=development bun run --watch ./src/main.ts",
    "dev:debug": "NODE_ENV=development bun --inspect-wait run --watch ./src/main.ts",
    "clean": "rm -rf dist && rm tsconfig.tsbuildinfo || echo 'No tsconfig.tsbuildinfo file found'",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "tdd": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "NODE_ENV=development drizzle-kit generate --config=drizzle-development.config.ts",
    "db:migrate": "NODE_ENV=development drizzle-kit migrate --config=drizzle-development.config.ts",
    "db:up": "NODE_ENV=development drizzle-kit up --config=drizzle-development.config.ts",
    "db:push": "NODE_ENV=development drizzle-kit push --config=drizzle-development.config.ts",
    "db:pull": "NODE_ENV=development drizzle-kit pull --config=drizzle-development.config.ts"
  },
  "devDependencies": {
    "@prj-conq/behave": "workspace:*",
    "@prj-conq/lib": "workspace:*",
    "@prj-conq/typescript-config": "workspace:*",
    "@types/bun": "^1.3.3",
    "bun-automock": "^0.2.5",
    "drizzle-kit": "^0.31.7",
    "fishery": "2.3.1",
    "playwright": "1.56.1",
    "sass": "1.94.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.5",
    "@elysiajs/html": "^1.4.0",
    "@elysiajs/opentelemetry": "^1.4.8",
    "@elysiajs/static": "^1.4.7",
    "@elysiajs/swagger": "^1.3.1",
    "@kitajs/html": "^4.2.11",
    "@kitajs/ts-html-plugin": "^4.1.3",
    "@libsql/client": "^0.15.15",
    "@picocss/pico": "^2.1.1",
    "@prj-conq/behave": "workspace:*",
    "@prj-conq/lib": "workspace:*",
    "bun-types": "^1.3.3",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.16",
    "flexboxgrid": "^6.3.1",
    "logixlysia": "5.3.0"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "bun": ">=1.2.21"
  }
}