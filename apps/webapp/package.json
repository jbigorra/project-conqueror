{
  "name": "@prj-conq/webapp",
  "private": true,
  "version": "0.1.0",
  "description": "Modulithic web application for Project Conqueror",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#hotspots/*": "./dist/features/hotspots/*",
    "#server/*": "./dist/server/*",
    "#shared/http/*": "./dist/shared/infrastructure/http/*",
    "#shared/ui/components/*": "./dist/shared/presentation/ui/components/*",
    "#shared/ui/partials/*": "./dist/shared/presentation/ui/partials/*",
    "#shared/ui/layouts/*": "./dist/shared/presentation/ui/layouts/*"
  },
  "scripts": {
    "build": "tsc",
    "build:prod": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server ./src/main.ts",
    "dev": "bun run --watch ./src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@prj-conq/typescript-config": "workspace:*",
    "@types/bun": "1",
    "fishery": "^2.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^3.1.0"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.3.8"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "bun": ">=1.2.2"
  }
}
