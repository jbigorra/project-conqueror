// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`UploadFilesController > GET /upload > should return response with html body 1`] = `
"<!doctype html><html lang="en" data-theme="light"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>Upload your files</title><meta name="color-scheme" content="light dark"/><link rel="stylesheet" href="css/pico.pink.css"/><link rel="stylesheet" href="css/flexboxgrid.css"/><link rel="stylesheet" href="css/layout.css"/><link rel="stylesheet" href="css/styles.css"/><script defer src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.6/dist/htmx.min.js" integrity="sha384-Akqfrbj/HpNVo8k11SXBb6TlBWmXXlYQrCSqEWmyKJe+hDm3Z/B2WVG4smwBkRVm" crossorigin="anonymous"></script>
        <script src="/upload/js/upload.page.js" defer></script>
        <link rel="stylesheet" href="/upload/css/upload.css">
      </head><body><header class="container"><nav><ul><li><hgroup><h2>TD Radar</h2><mark>Pay the tech debt that matters</mark></hgroup></li></ul><ul><li><a href="#">Analyze my repo</a></li><li><a href="#">What's this?</a></li><li><a href="#">Documentation</a></li></ul></nav></header><main class="container-fluid"><div class="row"><aside class="col-sm-2 col-md-2"><nav class="menu"><ul class="row center-xs"><li class="col-xs-12"><a href="#"><button class="secondary">Hotspots</button></a></li><li class="col-xs-12"><a href="#"><button class="secondary">Knowledge Distribution</button></a></li><li class="col-xs-12"><a href="#"><button class="secondary">Change Coupling</button></a></li><li class="col-xs-12"><a href="#"><button class="secondary">Entity Churn</button></a></li></ul></nav></aside><div class="col-sm-10 col-md-10"><div class="page-content"><div style="row"><div class="col-xs-12 col-md-12"><div class="row"><div class="col-xs-12 col-md-12"><p>1. Execute the commands below to generate a git log file.</p><pre class="terminal"><span class="user">user@laptop</span> <span class="path">~</span><br/><span class="path">→</span><span class="output">cd path/to/your/repo</span><br/><br/><span class="user">user@laptop</span> <span class="path">~/path/to/your/repo</span><br/><span class="path">→</span><span class="output">git log --all --numstat --date=short --pretty=format:'--%h--%ad--%aN' --no-renames --after=YYYY-MM-DD > logfile.log</span></pre><p>2. Upload the git log file.</p></div></div><div class="row"><div class="col-xs-12 center-xs"><form id="form" hx-post="/upload" hx-encoding="multipart/form-data" hx-target="#upload-response" hx-swap="afterend"><div aria-label="Upload a git log file" class="drop-area"><img src="upload/img/anim-file.svg" alt="animated file"/><span>Drop your git log file here or click to browse.</span><input id="file" type="file" name="file"/></div><button>Upload</button></form><div id="upload-response"></div></div></div></div></div></div></div></div></main><footer><div class="container"><div class="row"><div class="col-xs-12 col-md-12"><small>© 2025 Juan Bigorra. All rights reserved.</small></div></div></div></footer></body></html>"
`;
