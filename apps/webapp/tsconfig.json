{
  "extends": "@prj-conq/typescript-config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsxImportSource": "@kitajs/html",
    "plugins": [
      {
        "name": "@kitajs/ts-html-plugin"
      }
    ],
    "types": [
      "@vitest/browser/providers/playwright",
      "@kitajs/html/htmx.d.ts",
      "@kitajs/html/alpine.d.ts",
      "@types/bun"
    ]
  },
  "include": [
    "src/**/*",
    "package.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*"
  ]
}
