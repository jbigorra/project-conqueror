{
  "extends": "@prj-conq/typescript-config/base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "@kitajs/html",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@kitajs/ts-html-plugin"
      }
    ],
    "types": [
      "@vitest/browser/providers/playwright",
      "@kitajs/html/htmx.d.ts",
      "@kitajs/html/alpine.d.ts"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
